QMainWindow {
    background: #f3f6f8;
    color: #18212b;
    font-family: "Microsoft YaHei UI", "Segoe UI", Arial;
    font-size: 13px;
}

#centralwidget {
    background: #f3f6f8;
}

#tool_widget {
    background: #ffffff;
    border-bottom: 1px solid #d7dee7;
}

#connect_widget {
    background: transparent;
}

#status_widget {
    background: #ffffff;
    border-top: 1px solid #d7dee7;
}

#main_label {
    background: #0b1117;
    color: #8d99a8;
    border: 1px solid #cfd8e3;
}

QLabel {
    color: #26313d;
}

#selectDev_label,
#sendFilePro_label {
    color: #5a6675;
    font-weight: 600;
}

#status_label {
    color: #344255;
}

#fps_label {
    color: #0f766e;
    font-weight: 700;
    padding: 2px 8px;
    border: 1px solid #b7e4df;
    border-radius: 4px;
    background: #ecfdf9;
}

QPushButton {
    min-height: 24px;
    padding: 2px 14px;
    border: 1px solid #c9d4e2;
    border-radius: 5px;
    background: #ffffff;
    color: #1f2a37;
}

QPushButton:hover {
    background: #f6f9fc;
    border-color: #9fb0c4;
}

QPushButton:pressed {
    background: #e9eef5;
    border-color: #7f93ad;
}

QPushButton:disabled {
    background: #eef2f6;
    color: #9aa6b2;
    border-color: #d8e0ea;
}

#connect_pushButton {
    background: #0f766e;
    border-color: #0f766e;
    color: #ffffff;
    font-weight: 600;
}

#connect_pushButton:hover {
    background: #115e59;
    border-color: #115e59;
}

#connect_pushButton:pressed {
    background: #134e4a;
    border-color: #134e4a;
}

#connect_pushButton:disabled {
    background: #a7d8d2;
    border-color: #a7d8d2;
    color: #f7fbfb;
}

#disconnect_pushButton {
    color: #b42318;
    border-color: #f2b8b5;
    background: #fff7f6;
}

#disconnect_pushButton:hover {
    background: #fee4e2;
    border-color: #f99b95;
}

#sendFile_pushButton {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
}

#sendFile_pushButton:hover {
    background: #1e40af;
    border-color: #1e40af;
}

#sendFile_pushButton:disabled {
    background: #b8c7ef;
    border-color: #b8c7ef;
    color: #f8fbff;
}

QComboBox {
    min-height: 24px;
    padding: 2px 30px 2px 10px;
    border: 1px solid #c9d4e2;
    border-radius: 5px;
    background: #ffffff;
    color: #1f2a37;
}

QComboBox:hover {
    border-color: #9fb0c4;
}

QComboBox:focus {
    border-color: #0f766e;
}

QComboBox::drop-down {
    width: 26px;
    border: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QComboBox::down-arrow {
    image: url(:/icon/icons/combo-arrow.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    border: 1px solid #c9d4e2;
    background: #ffffff;
    selection-background-color: #dff4f1;
    selection-color: #102a2a;
    outline: 0;
}

QProgressBar {
    min-height: 18px;
    border: 1px solid #c9d4e2;
    border-radius: 5px;
    background: #eef3f8;
    color: #344255;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 4px;
    background: #0f766e;
}

QMenuBar {
    background: #f8fafc;
    border-bottom: 1px solid #d7dee7;
}

QStatusBar {
    background: #f8fafc;
    border-top: 1px solid #d7dee7;
    color: #5a6675;
}
