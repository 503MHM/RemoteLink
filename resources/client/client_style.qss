/*
WinUI 3 / Fluent Design Inspired Style Sheet
Accent: #0078D4  Surface: #FFFFFF  Background: #F3F3F3
*/

QMainWindow, QDialog, QColorDialog {
    background-color: #f3f3f3;
}

QLabel {
    color: #1a1a1a;
    background: transparent;
}

QCheckBox, QRadioButton {
    color: #1a1a1a;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8e8e8e;
    background-color: #ffffff;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #616161;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

QCheckBox::indicator:disabled {
    border-color: #d1d1d1;
    background-color: #f3f3f3;
}

QComboBox {
    color: #1a1a1a;
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #8e8e8e;
}

QComboBox QAbstractItemView {
    color: #1a1a1a;
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    selection-color: #ffffff;
    selection-background-color: #0078d4;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QDateTimeEdit, QDateEdit, QTimeEdit, QFontComboBox {
    color: #1a1a1a;
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0078d4;
    padding: 3px 7px;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #8e8e8e;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f9f9f9;
    color: #a0a0a0;
}

QMenuBar {
    background-color: #f3f3f3;
    border-bottom: 1px solid #e0e0e0;
    color: #1a1a1a;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e5e5e5;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    color: #1a1a1a;
    padding: 6px 32px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 8px;
}

QProgressBar {
    text-align: center;
    color: #ffffff;
    background-color: #e0e0e0;
    border: none;
    border-radius: 4px;
    min-height: 4px;
    max-height: 4px;
    font-size: 0px;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 4px;
}

QPushButton {
    color: #1a1a1a;
    background-color: #f3f3f3;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #e5e5e5;
    border-color: #b8b8b8;
}

QPushButton:pressed {
    background-color: #d3d3d3;
    border-color: #9a9a9a;
}

QPushButton:disabled {
    color: #a0a0a0;
    background-color: #f3f3f3;
    border-color: #e0e0e0;
}

QPushButton:default {
    color: #ffffff;
    background-color: #0078d4;
    border: 1px solid #0078d4;
}

QPushButton:default:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}

QPushButton:default:pressed {
    background-color: #005a9e;
    border-color: #005a9e;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #d1d1d1;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background: #d1d1d1;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #8e8e8e;
    border-radius: 10px;
    width: 18px;
    margin: -8px 0;
}

QSlider::handle:vertical {
    background: #ffffff;
    border: 1px solid #8e8e8e;
    border-radius: 10px;
    height: 18px;
    margin: 0 -8px;
}

QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover {
    background: #0078d4;
    border-color: #0078d4;
}

QSlider::sub-page:horizontal {
    background: #0078d4;
    border-radius: 2px;
}

QSlider::add-page:horizontal, QSlider::sub-page:vertical {
    background: #d1d1d1;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background: #0078d4;
    border-radius: 2px;
}

QStatusBar {
    color: #616161;
    background-color: #f3f3f3;
    border-top: 1px solid #e0e0e0;
}

QStatusBar::item {
    border: none;
}

QScrollBar:horizontal {
    height: 12px;
    background: #f3f3f3;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border: none;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px 0;
}

QScrollBar::handle:horizontal:hover {
    background: #8e8e8e;
}

QScrollBar::handle:horizontal:pressed {
    background: #616161;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    border: none;
}

QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar:vertical {
    width: 12px;
    background: #f3f3f3;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c1c1c1;
    border: none;
    border-radius: 6px;
    min-height: 30px;
    margin: 0 2px;
}

QScrollBar::handle:vertical:hover {
    background: #8e8e8e;
}

QScrollBar::handle:vertical:pressed {
    background: #616161;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0px;
    border: none;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #d1d1d1;
    border-radius: 0 0 8px 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    color: #616161;
    background-color: #f3f3f3;
    border: 1px solid #d1d1d1;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 16px;
    min-width: 60px;
}

QTabBar::tab:selected {
    color: #1a1a1a;
    background-color: #ffffff;
    border-color: #d1d1d1;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background-color: #e5e5e5;
}

QGroupBox {
    color: #1a1a1a;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #1a1a1a;
}

QToolTip {
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QToolBox {
    color: #1a1a1a;
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
}

QToolBox::tab {
    color: #1a1a1a;
    background-color: #f3f3f3;
    border-bottom: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px 12px;
}

QToolBox::tab:selected {
    background-color: #ffffff;
    font-weight: bold;
}